<?xml version="1.0" encoding="utf-8"?>
<Recipe id="cal_resistance_001" name="Resistance Calibration">
    <Description>Calibration procedure for resistance ranges</Description>
    <RequiredRoles>
        <Role>Calibrator</Role>
        <Role>Calibree</Role>
    </RequiredRoles>
    <Steps>
        <Step type="Switch" order="1" name="Select Resistance Path">
            <DeviceRole>SwitchMatrix</DeviceRole>
            <Action>SetChannel</Action>
            <Parameters>
                <RouteName>Resistance</RouteName>
            </Parameters>
        </Step>
        
        <Step type="Wait" order="2" name="Settling Time">
            <Duration>1000</Duration>
        </Step>
        
        <Step type="Configure" order="3" name="Set Calibrator 100 Ohm">
            <DeviceRole>Calibrator</DeviceRole>
            <Action>SetOutput</Action>
            <Parameters>
                <Resistance>100.0</Resistance>
                <Unit>Ohm</Unit>
            </Parameters>
        </Step>
        
        <Step type="Wait" order="4" name="Output Settling">
            <Duration>1000</Duration>
        </Step>
        
        <Step type="Measurement" order="5" name="Measure 100 Ohm">
            <DeviceRole>Calibree</DeviceRole>
            <Action>Measure</Action>
            <Parameters>
                <Range>200</Range>
                <Unit>Ohm</Unit>
                <MeasurementType>Resistance</MeasurementType>
            </Parameters>
            <Tolerance>
                <Nominal>100.0</Nominal>
                <ErrorPercent>0.1</ErrorPercent>
            </Tolerance>
            <OnFail>Prompt</OnFail>
        </Step>
        
        <Step type="Configure" order="6" name="Set Calibrator 1k Ohm">
            <DeviceRole>Calibrator</DeviceRole>
            <Action>SetOutput</Action>
            <Parameters>
                <Resistance>1000.0</Resistance>
                <Unit>Ohm</Unit>
            </Parameters>
        </Step>
        
        <Step type="Wait" order="7" name="Output Settling">
            <Duration>1000</Duration>
        </Step>
        
        <Step type="Measurement" order="8" name="Measure 1k Ohm">
            <DeviceRole>Calibree</DeviceRole>
            <Action>Measure</Action>
            <Parameters>
                <Range>2000</Range>
                <Unit>Ohm</Unit>
                <MeasurementType>Resistance</MeasurementType>
            </Parameters>
            <Tolerance>
                <Nominal>1000.0</Nominal>
                <ErrorPercent>0.05</ErrorPercent>
            </Tolerance>
            <OnFail>Prompt</OnFail>
        </Step>
    </Steps>
</Recipe>

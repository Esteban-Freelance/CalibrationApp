<?xml version="1.0" encoding="utf-8"?>
<TestBench id="station1" name="Real Calibration Station">
    <Devices>
        <!-- Power Source -->
        <Device ref="eaPowerSource_001" role="PowerSource" />
        <!-- Reference Meter (Keithley - "Richtiger Wert") -->
        <Device ref="keithley3706a_001" role="Reference" />
        <!-- DUT (H&amp;H ZS Lasten - "Anzeige") -->
        <Device ref="hhload_001" role="DUT" />
        <!-- Switch/Relay for routing -->
        <Device ref="relaycard_001" role="SwitchMatrix" />
    </Devices>
    <Wiring>
        <Route name="VoltageDC" switchChannel="1" description="DC Voltage path (PowerSource -> DUT)" />
        <Route name="CurrentDC" switchChannel="2" description="DC Current path" />
        <Route name="Resistance" switchChannel="3" description="4-wire Resistance path" />
        <Route name="VoltageAC" switchChannel="4" description="AC Voltage path" />
        <Route name="CurrentAC" switchChannel="5" description="AC Current path" />
    </Wiring>
</TestBench>

<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CalibriAvalonia.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
        x:Class="CalibriAvalonia.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Calibration System"
        Width="1200" Height="800"
        WindowStartupLocation="CenterScreen"
        Background="#F3F4F6">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="200"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="16" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <!-- Test Bench Selection -->
                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                    <TextBlock Text="Test Bench" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding TestBenches}" 
                              SelectedItem="{Binding SelectedTestBench}"
                              Height="32"
                              HorizontalAlignment="Stretch">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
                
                <!-- Recipe Selection -->
                <StackPanel Grid.Column="1" Margin="0,0,16,0">
                    <TextBlock Text="Recipe" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding Recipes}" 
                              SelectedItem="{Binding SelectedRecipe}"
                              Height="32"
                              HorizontalAlignment="Stretch">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
                
                <!-- Control Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button Content="▶ Run" 
                            Command="{Binding RunRecipeCommand}"
                            IsEnabled="{Binding CanRun}"
                            Classes="Primary"
                            Margin="0,0,8,0"
                            Padding="16,8"/>
                    
                    <Button Content="⏸ Pause" 
                            Command="{Binding PauseRecipeCommand}"
                            IsVisible="{Binding IsRunning}"
                            Classes="Primary"
                            Margin="0,0,8,0"
                            Padding="16,8"/>
                    
                    <Button Content="▶ Resume" 
                            Command="{Binding ResumeRecipeCommand}"
                            IsVisible="{Binding IsPaused}"
                            Classes="Primary"
                            Margin="0,0,8,0"
                            Padding="16,8"/>
                    
                    <Button Content="⏹ Abort" 
                            Command="{Binding AbortRecipeCommand}"
                            IsVisible="{Binding IsRunning}"
                            Classes="Danger"
                            Margin="0,0,8,0"
                            Padding="16,8"/>
                    
                    <Button Content="⚡ Safe Shutdown" 
                            Command="{Binding SafeShutdownCommand}"
                            Classes="Danger"
                            Padding="16,8"/>
                </StackPanel>
            </Grid>
        </Border>
        
        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>
            
            <!-- Devices Panel -->
            <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="16" Margin="0,0,8,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Connected Devices" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,12"/>
                    
                    <ItemsControl ItemsSource="{Binding Devices}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="4" Padding="12,8" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        
                                        <!-- Status Indicator -->
                                        <Ellipse Grid.Column="0" Grid.RowSpan="2" Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center"
                                                 Fill="{Binding IsConnected, Converter={StaticResource BoolToConnectionColorConverter}}"/>
                                        
                                        <TextBlock Grid.Column="1" Grid.Row="0" Text="{Binding Role}" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Column="1" Grid.Row="1" Text="{Binding Name}" Foreground="#6B7280" FontSize="12"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Border>
            
            <!-- Recipe Steps Panel -->
            <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="16" Margin="8,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Recipe Steps" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,12"/>
                    
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Steps}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,2" Padding="12,10" CornerRadius="4"
                                            Background="{Binding IsCurrent, Converter={StaticResource BoolToBrushConverter}}"
                                            BorderBrush="{Binding IsCurrent, Converter={StaticResource BoolToBorderBrushConverter}}"
                                            BorderThickness="2">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <!-- Step Number -->
                                            <Border Grid.Column="0" Width="28" Height="28" CornerRadius="14" Margin="0,0,12,0" VerticalAlignment="Center"
                                                    Background="{Binding Status, Converter={StaticResource StatusToColorConverter}}">
                                                <TextBlock Text="{Binding Order}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="White"/>
                                            </Border>
                                            
                                            <!-- Step Info -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Type}" Foreground="#6B7280" FontSize="12"/>
                                            </StackPanel>
                                            
                                            <!-- Measured Value -->
                                            <TextBlock Grid.Column="2" Text="{Binding MeasuredValue}" 
                                                       VerticalAlignment="Center" Margin="0,0,16,0"
                                                       FontFamily="Consolas" Foreground="#374151"/>
                                            
                                            <!-- Status Badge -->
                                            <Border Grid.Column="3" CornerRadius="4" Padding="8,4" VerticalAlignment="Center"
                                                    Background="{Binding Status, Converter={StaticResource StatusToBadgeColorConverter}}">
                                                <TextBlock Text="{Binding Status}" FontSize="12"
                                                           Foreground="{Binding Status, Converter={StaticResource StatusToBadgeForegroundConverter}}"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
            
            <!-- Current Measurement Panel -->
            <Border Grid.Column="2" Background="White" CornerRadius="8" Padding="16" Margin="8,0,0,0">
                <StackPanel>
                    <TextBlock Text="Current Measurement" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,16"/>
                    
                    <Border Background="#F9FAFB" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Value" Foreground="#6B7280" FontSize="12"/>
                            <TextBlock Text="{Binding CurrentMeasurement}" FontSize="24" FontWeight="Bold" FontFamily="Consolas"/>
                        </StackPanel>
                    </Border>
                    
                    <Border Background="#F9FAFB" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Tolerance" Foreground="#6B7280" FontSize="12"/>
                            <TextBlock Text="{Binding CurrentTolerance}" FontSize="14" FontFamily="Consolas"/>
                        </StackPanel>
                    </Border>
                    
                    <Border CornerRadius="8" Padding="16"
                            Background="{Binding OverallResult, Converter={StaticResource ResultToBrushConverter}}">
                        <StackPanel>
                            <TextBlock Text="Status" Foreground="#6B7280" FontSize="12"/>
                            <TextBlock Text="{Binding CurrentStatus}" FontSize="14" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
        
        <!-- Log Panel -->
        <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="16" Margin="0,16,0,0">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                    <TextBlock Text="Log" FontWeight="SemiBold" FontSize="14"/>
                    <Button Content="Clear" Command="{Binding ClearLogCommand}" 
                            HorizontalAlignment="Right" 
                            Background="Transparent" 
                            Foreground="#3B82F6" Cursor="Hand"/>
                </Grid>
                
                <Border Background="#1F2937" CornerRadius="4" Padding="8">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding LogEntries}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding FormattedMessage}" 
                                               FontFamily="Consolas" FontSize="12"
                                               Foreground="{Binding Level, Converter={StaticResource LogLevelToColorConverter}}"
                                               TextWrapping="NoWrap"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </DockPanel>
        </Border>
    </Grid>

    <Window.Styles>
        <Style Selector="Button.Primary">
            <Setter Property="Background" Value="#3B82F6"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CornerRadius" Value="4"/>
        </Style>
        <Style Selector="Button.Danger">
            <Setter Property="Background" Value="#EF4444"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CornerRadius" Value="4"/>
        </Style>
    </Window.Styles>
    
    <Window.Resources>
        <vm:BoolToBrushConverter x:Key="BoolToBrushConverter"/>
        <vm:BoolToBorderBrushConverter x:Key="BoolToBorderBrushConverter"/>
        <vm:StatusToColorConverter x:Key="StatusToColorConverter"/>
        <vm:StatusToBadgeColorConverter x:Key="StatusToBadgeColorConverter"/>
        <vm:StatusToBadgeForegroundConverter x:Key="StatusToBadgeForegroundConverter"/>
        <vm:ResultToBrushConverter x:Key="ResultToBrushConverter"/>
        <vm:LogLevelToColorConverter x:Key="LogLevelToColorConverter"/>
        <vm:BoolToConnectionColorConverter x:Key="BoolToConnectionColorConverter"/>
    </Window.Resources>
</Window>

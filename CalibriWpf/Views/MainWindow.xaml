<Window x:Class="CalibrationApp.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:CalibrationApp.ViewModels"
        xmlns:logging="clr-namespace:CalibrationDevices.Logging;assembly=CalibriDevices"
        Title="Calibration System" 
        Height="800" Width="1200"
        Background="{StaticResource BackgroundBrush}"
        WindowStartupLocation="CenterScreen">
    
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>
    
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        
        <!-- Log Level to Color Converter -->
        <Style TargetType="TextBlock" x:Key="LogEntryStyle">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Level}" Value="{x:Static logging:LogLevel.Error}">
                    <Setter Property="Foreground" Value="{StaticResource ErrorBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="{x:Static logging:LogLevel.Warning}">
                    <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="{x:Static logging:LogLevel.Info}">
                    <Setter Property="Foreground" Value="#1F2937"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="{x:Static logging:LogLevel.Debug}">
                    <Setter Property="Foreground" Value="#6B7280"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        
        <!-- Step Status Style -->
        <Style TargetType="Border" x:Key="StepBorderStyle">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0,2"/>
        </Style>
    </Window.Resources>
    
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="200"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="16" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <!-- Test Bench Selection -->
                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                    <TextBlock Text="Test Bench" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding TestBenches}" 
                              SelectedItem="{Binding SelectedTestBench}"
                              DisplayMemberPath="Name"
                              Height="32"/>
                </StackPanel>
                
                <!-- Recipe Selection -->
                <StackPanel Grid.Column="1" Margin="0,0,16,0">
                    <TextBlock Text="Recipe" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding Recipes}" 
                              SelectedItem="{Binding SelectedRecipe}"
                              DisplayMemberPath="Name"
                              Height="32"/>
                </StackPanel>
                
                <!-- Control Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button Content="▶ Run" 
                            Command="{Binding RunRecipeCommand}"
                            IsEnabled="{Binding CanRun}"
                            Style="{StaticResource PrimaryButton}"
                            Margin="0,0,8,0"/>
                    
                    <Button Content="⏸ Pause" 
                            Command="{Binding PauseRecipeCommand}"
                            Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}"
                            Style="{StaticResource PrimaryButton}"
                            Margin="0,0,8,0"/>
                    
                    <Button Content="▶ Resume" 
                            Command="{Binding ResumeRecipeCommand}"
                            Visibility="{Binding IsPaused, Converter={StaticResource BoolToVis}}"
                            Style="{StaticResource PrimaryButton}"
                            Margin="0,0,8,0"/>
                    
                    <Button Content="⏹ Abort" 
                            Command="{Binding AbortRecipeCommand}"
                            Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}"
                            Style="{StaticResource DangerButton}"
                            Margin="0,0,8,0"/>
                    
                    <Button Content="⚡ Safe Shutdown" 
                            Command="{Binding SafeShutdownCommand}"
                            Style="{StaticResource DangerButton}"/>
                </StackPanel>
            </Grid>
        </Border>
        
        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>
            
            <!-- Devices Panel -->
            <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="16" Margin="0,0,8,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Connected Devices" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,12"/>
                    
                    <ItemsControl ItemsSource="{Binding Devices}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="4" Padding="12,8" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        
                                        <!-- Status Indicator -->
                                        <Ellipse Grid.Column="0" Grid.RowSpan="2" Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="#9CA3AF"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                            <Setter Property="Fill" Value="{StaticResource SuccessBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        
                                        <TextBlock Grid.Column="1" Grid.Row="0" Text="{Binding Role}" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Column="1" Grid.Row="1" Text="{Binding Name}" Foreground="#6B7280" FontSize="12"/>
                                        <TextBlock Grid.Column="1" Grid.Row="2" FontSize="10" Foreground="#9CA3AF">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="{}{0}:{1}">
                                                    <Binding Path="Address"/>
                                                    <Binding Path="Port"/>
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                        
                                        <!-- Action Buttons -->
                                        <StackPanel Grid.Column="2" Grid.RowSpan="3" Orientation="Vertical" VerticalAlignment="Center" Margin="8,0,0,0">
                                            <Button Content="⟳" 
                                                    Command="{Binding DataContext.ReconnectDeviceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="Reconnect"
                                                    Width="28" Height="28" Padding="0"
                                                    Background="#F3F4F6" BorderThickness="1" BorderBrush="#D1D5DB" Margin="0,0,0,4"/>
                                            <Button Content="⚙" 
                                                    Command="{Binding DataContext.EditDeviceConfigCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="Edit Config"
                                                    Width="28" Height="28" Padding="0"
                                                    Background="#F3F4F6" BorderThickness="1" BorderBrush="#D1D5DB"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Border>
            
            <!-- Recipe Steps Panel -->
            <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="16" Margin="8,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Recipe Steps" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,12"/>
                    
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Steps}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,2" Padding="12,10" CornerRadius="4">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="White"/>
                                                <Setter Property="BorderBrush" Value="#E5E7EB"/>
                                                <Setter Property="BorderThickness" Value="1"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                        <Setter Property="Background" Value="#EFF6FF"/>
                                                        <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                                        <Setter Property="BorderThickness" Value="2"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Passed">
                                                        <Setter Property="Background" Value="#F0FDF4"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Failed">
                                                        <Setter Property="Background" Value="#FEF2F2"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <!-- Step Number -->
                                            <Border Grid.Column="0" Width="28" Height="28" CornerRadius="14" Margin="0,0,12,0" VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#E5E7EB"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Running">
                                                                <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Passed">
                                                                <Setter Property="Background" Value="{StaticResource SuccessBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Failed">
                                                                <Setter Property="Background" Value="{StaticResource ErrorBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding Order}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#374151"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Status}" Value="Running">
                                                                    <Setter Property="Foreground" Value="White"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="Passed">
                                                                    <Setter Property="Foreground" Value="White"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="Failed">
                                                                    <Setter Property="Foreground" Value="White"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                            
                                            <!-- Step Info -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Type}" Foreground="#6B7280" FontSize="12"/>
                                            </StackPanel>
                                            
                                            <!-- Measured Value -->
                                            <TextBlock Grid.Column="2" Text="{Binding MeasuredValue}" 
                                                       VerticalAlignment="Center" Margin="0,0,16,0"
                                                       FontFamily="Consolas" Foreground="#374151"/>
                                            
                                            <!-- Status Badge -->
                                            <Border Grid.Column="3" CornerRadius="4" Padding="8,4" VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#F3F4F6"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Running">
                                                                <Setter Property="Background" Value="#DBEAFE"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Passed">
                                                                <Setter Property="Background" Value="#DCFCE7"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Failed">
                                                                <Setter Property="Background" Value="#FEE2E2"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding Status}" FontSize="12">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#6B7280"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Status}" Value="Running">
                                                                    <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="Passed">
                                                                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="Failed">
                                                                    <Setter Property="Foreground" Value="{StaticResource ErrorBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
            
            <!-- Current Measurement Panel -->
            <Border Grid.Column="2" Background="White" CornerRadius="8" Padding="16" Margin="8,0,0,0">
                <StackPanel>
                    <TextBlock Text="Current Measurement" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,16"/>
                    
                    <Border Background="#F9FAFB" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Value" Foreground="#6B7280" FontSize="12"/>
                            <TextBlock Text="{Binding CurrentMeasurement}" FontSize="24" FontWeight="Bold" FontFamily="Consolas"/>
                        </StackPanel>
                    </Border>
                    
                    <Border Background="#F9FAFB" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Tolerance" Foreground="#6B7280" FontSize="12"/>
                            <TextBlock Text="{Binding CurrentTolerance}" FontSize="14" FontFamily="Consolas"/>
                        </StackPanel>
                    </Border>
                    
                    <Border CornerRadius="8" Padding="16">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#F9FAFB"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding OverallResult}" Value="Passed">
                                        <Setter Property="Background" Value="#DCFCE7"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding OverallResult}" Value="Failed">
                                        <Setter Property="Background" Value="#FEE2E2"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding OverallResult}" Value="InProgress">
                                        <Setter Property="Background" Value="#DBEAFE"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="Status" Foreground="#6B7280" FontSize="12"/>
                            <TextBlock Text="{Binding CurrentStatus}" FontSize="14" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
        
        <!-- Log Panel -->
        <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="16" Margin="0,16,0,0">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                    <TextBlock Text="Log" FontWeight="SemiBold" FontSize="14"/>
                    <Button Content="Clear" Command="{Binding ClearLogCommand}" 
                            HorizontalAlignment="Right" 
                            Background="Transparent" BorderThickness="0" 
                            Foreground="{StaticResource PrimaryBrush}" Cursor="Hand"/>
                </Grid>
                
                <Border Background="#1F2937" CornerRadius="4" Padding="8">
                    <ScrollViewer x:Name="LogScrollViewer" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding LogEntries}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding FormattedMessage}" 
                                               FontFamily="Consolas" FontSize="12"
                                               Style="{StaticResource LogEntryStyle}"
                                               TextWrapping="NoWrap"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </DockPanel>
        </Border>
    </Grid>
</Window>

<?xml version="1.0" encoding="utf-8"?>
<Recipe id="HuH-Load-60V-Voltag" name="HuH Load 60V DC Voltage - EA-PS, Keithley 3706A">
  <Description>Calibration of Höcherl &amp; Hackl Electronic Load ZS 530-3-SV60-ZS02-ZS13-SA9. DC Voltage only (18Bit and 13Bit). EA-PS as power supply, Keithley 3706A as reference meter (source of truth).</Description>
  <Version>1.0</Version>
  <Author>CalibrationApp</Author>
  <CreatedDate>2026-02-15</CreatedDate>

  <RequiredDevices>
    <Device role="PowerSource" type="Source" description="EA-PS Power Supply - Supplies voltage to the load" />
    <Device role="ReferenceMeter" type="Measurement" description="Keithley 3706A - Reference meter (source of truth / Richtiger Wert)" />
    <Device role="DUT" type="Measurement" description="Höcherl &amp; Hackl ZS 530 - Device under test" />
  </RequiredDevices>

  <Steps>

    <!-- INITIALIZATION -->

    <Step type="Message" order="1" name="Start Calibration">
      <Description>Initialize calibration of Höcherl &amp; Hackl Electronic Load - DC Voltage</Description>
    </Step>





    <!--<Step type="Configure" order="4" name="Reset Reference Meter">
      <DeviceRole>ReferenceMeter</DeviceRole>
      <Action>Reset</Action>
    </Step>

    <Step type="Configure" order="5" name="Reset DUT">
      <DeviceRole>DUT</DeviceRole>
      <Action>Reset</Action>
    </Step>-->

    <!--<Step type="Wait" order="6" name="Settling after reset">
      <Duration>3000</Duration>
    </Step>-->

    <!-- ================================================================== -->
    <!-- SECTION 1: DC VOLTAGE 60V - 18Bit                                  -->
    <!-- 0V, 5V, 10V, 20V, 30V, 40V, 50V, 60V                             -->
    <!-- ================================================================== -->

    <!--<Step type="Message" order="100" name="DC Voltage 60V 18Bit - Begin">
      <Description>Starting DC Voltage measurement, 60V range, 18Bit resolution</Description>
    </Step>-->

	<!-- 0V DC 18Bit -->
	<Step type="Configure" order="10" name="Set Power Supply 0A DC">
		<DeviceRole>PowerSource</DeviceRole>
		<Action>SetOutput</Action>
		<Parameters>
			<SourceType>CurrentDC</SourceType>
			<Value>1</Value>
			<Unit>A</Unit>
			<Current>1</Current>
		</Parameters>
	</Step>

	<Step type="Wait" order="11" name="Settling 1A DC">
		<Duration>2000</Duration>
	</Step>

	<Step type="Switch" order="12" name="Set Relay to On">
		<DeviceRole>Relay</DeviceRole>
		<Action>Relay ON</Action>
		<Parameters>
			<RouteName>ON</RouteName>
		</Parameters>
	</Step>

	<Step type="Measurement" order="13" name="DUT Read 1A DC 18Bit">
		<DeviceRole>DUT</DeviceRole>
		<Action>Measure</Action>
		<Parameters>
			<MeasurementType>CurrentDC</MeasurementType>
			<Range>1.2</Range>
			<Unit>A</Unit>
			<Resolution>18Bit</Resolution>
		</Parameters>
		<Tolerance>
			<Nominal>0</Nominal>
			<AbsoluteError>0.030</AbsoluteError>
			<Unit>V</Unit>
		</Tolerance>
		<MeasurementUncertainty>0.030</MeasurementUncertainty>
		<OnFail>Prompt</OnFail>
	</Step>

	<Step type="Measurement" order="14" name="Reference Meter Read 1A DC">
		<DeviceRole>ReferenceMeter</DeviceRole>
		<Action>Measure</Action>
		<Parameters>
			<ShuntResistance>0.01</ShuntResistance>
			<MeasurementType>currentshunt</MeasurementType>
			<Range>1</Range>
			<Unit>V</Unit>
			<Channel>1002</Channel>
		</Parameters>
		<StoreAs>RefMeter_DCV18_0V</StoreAs>
	</Step>

	<Step type="Configure" order="15" name="Set Power Supply 5A DC">
		<DeviceRole>PowerSource</DeviceRole>
		<Action>SetOutput</Action>
		<Parameters>
			<SourceType>CurrentDC</SourceType>
			<Value>5</Value>
			<Unit>A</Unit>
			<Current>5</Current>
		</Parameters>
	</Step>

	<Step type="Measurement" order="16" name="DUT Read 5A DC 18Bit">
		<DeviceRole>DUT</DeviceRole>
		<Action>Measure</Action>
		<Parameters>
			<MeasurementType>CurrentDC</MeasurementType>
			<Range>12</Range>
			<Unit>A</Unit>
			<Resolution>18Bit</Resolution>
		</Parameters>
		<Tolerance>
			<Nominal>0</Nominal>
			<AbsoluteError>0.030</AbsoluteError>
			<Unit>V</Unit>
		</Tolerance>
		<MeasurementUncertainty>0.030</MeasurementUncertainty>
		<OnFail>Prompt</OnFail>
	</Step>

	<Step type="Measurement" order="17" name="Reference Meter Read 1A DC">
		<DeviceRole>ReferenceMeter</DeviceRole>
		<Action>Measure</Action>
		<Parameters>
			<ShuntResistance>0.01</ShuntResistance>
			<MeasurementType>currentshunt</MeasurementType>
			<Range>1</Range>
			<Unit>V</Unit>
			<Channel>1002</Channel>
		</Parameters>
		<StoreAs>RefMeter_DCV18_0V</StoreAs>
	</Step>

	<Step type="Configure" order="18" name="Reset Power Supply">
		<DeviceRole>PowerSource</DeviceRole>
		<Action>Reset</Action>
	</Step>

    <!-- 0V DC 18Bit -->
    <!--<Step type="Configure" order="101" name="Set Power Supply 0V DC">

        <Value>0</Value>
        <Unit>V</Unit>
      </Parameters>
    </Step>
	  
    <Step type="Wait" order="102" name="Settling 0V DC">
      <Duration>2000</Duration>
    </Step>

	<Step type="Switch" order="103" name="Set Relay to Off">
		<DeviceRole>Relay</DeviceRole>
		<Action>Relay Off</Action>
		<Parameters>
			<RouteName>OFF</RouteName>
		</Parameters>
	</Step>
	  
    <Step type="Measurement" order="105" name="Reference Meter Read 0V DC">
      <DeviceRole>ReferenceMeter</DeviceRole>
      <Action>Measure</Action>
      <Parameters>
        <MeasurementType>VoltageDC</MeasurementType>
        <Range>100</Range>
        <Unit>V</Unit>
		<Channel>1001</Channel>
      </Parameters>
      <StoreAs>RefMeter_DCV18_0V</StoreAs>
    </Step>
	  
    <Step type="Measurement" order="106" name="DUT Read 0V DC 18Bit">
      <DeviceRole>DUT</DeviceRole>
      <Action>Measure</Action>
      <Parameters>
        <MeasurementType>VoltageDC</MeasurementType>
        <Range>60</Range>
        <Unit>V</Unit>
        <Resolution>18Bit</Resolution>
      </Parameters>
      <Tolerance>
        <Nominal>0</Nominal>
        <AbsoluteError>0.030</AbsoluteError>
        <Unit>V</Unit>
      </Tolerance>
      <MeasurementUncertainty>0.030</MeasurementUncertainty>
      <OnFail>Prompt</OnFail>
    </Step>

